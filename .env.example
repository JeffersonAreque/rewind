# Copy this file to .env and fill in your own values. Never commit .env.

# Active provider: fireworks | baseten
REWIND_PROVIDER=fireworks

# Fireworks (OpenAI-compatible)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=

# Baseten (OpenAI-compatible)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=

# SAM 3.1 (optional, future). Not used yet: Muse Spark Open does all the work
# and nothing depends on SAM. Reserved for refining element boxes once there
# is access to Meta's API.
SAM_API_KEY=

# Legacy demo app session key (optional; a random one is generated if empty)
LEGACY_SECRET_KEY=
