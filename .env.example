# Copy this file to .env and fill in your own values. Never commit .env.

# Active provider: fireworks | baseten
REWIND_PROVIDER=fireworks

# Fireworks (OpenAI-compatible)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=

# Baseten (OpenAI-compatible)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=

# SAM 3.1 on a Modal GPU (optional): outlines each verified element in the
# report. Off when empty; "sam" turns it on. Muse Spark Open does all the
# other work and nothing depends on SAM. Needs `uv run modal token new` (or the
# two MODAL_TOKEN_* values), a Modal secret named "huggingface" with HF_TOKEN,
# a payment method on Modal (GPU) and access to the gated Hugging Face repo.
REWIND_SEGMENTATION=
SAM_REPO=facebook/sam3.1
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Legacy demo app session key (optional; a random one is generated if empty)
LEGACY_SECRET_KEY=
