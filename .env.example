# Copy this file to .env and fill in your own values. Never commit .env.

# Active provider: fireworks | baseten
REWIND_PROVIDER=fireworks

# Fireworks (OpenAI-compatible)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=

# Baseten (OpenAI-compatible)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=

# Legacy demo app session key (optional; a random one is generated if empty)
LEGACY_SECRET_KEY=
