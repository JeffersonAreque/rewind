{
  "video": "samples/facturacion-demo.mp4",
  "about": "What the flows agent should find in the demo video. Written by hand from docs/grabar-video.md and legacy-demo/, which Rewind never sees. Only what the video shows.",
  "steps": [
    {"screen": "INICIO DE SESION", "action": "open_screen", "target": "INICIO DE SESION"},
    {"screen": "INICIO DE SESION", "action": "type", "target": "USUARIO", "value": "ADMIN"},
    {"screen": "INICIO DE SESION", "action": "type", "target": "CLAVE", "masked": true},
    {"screen": "INICIO DE SESION", "action": "click", "target": "ACEPTAR"},
    {"screen": "REGISTRO DE CLIENTES", "action": "open_screen", "target": "REGISTRO DE CLIENTES"},
    {"screen": "REGISTRO DE CLIENTES", "action": "click", "target": "GRABAR"},
    {"screen": "REGISTRO DE CLIENTES", "action": "see_message", "code": "0x0042", "target": "ERROR 0x0042: CAMPO OBLIGATORIO"},
    {"screen": "REGISTRO DE CLIENTES", "action": "click", "target": "ACEPTAR"},
    {"screen": "REGISTRO DE CLIENTES", "action": "type", "target": "RUC / DNI", "value": "20612345678"},
    {"screen": "REGISTRO DE CLIENTES", "action": "type", "target": "RAZON SOCIAL", "value": "FERRETERIA EL CASTAÑAL S.A.C."},
    {"screen": "REGISTRO DE CLIENTES", "action": "type", "target": "DIRECCION", "value": "JR. LORETO 455 - PUERTO MALDONADO"},
    {"screen": "REGISTRO DE CLIENTES", "action": "click", "target": "GRABAR"},
    {"screen": "REGISTRO DE CLIENTES", "action": "see_message", "target": "OPERACION COMPLETADA SATISFACTORIAMENTE."},
    {"screen": "REGISTRO DE CLIENTES", "action": "click", "target": "ACEPTAR"},
    {"screen": "REGISTRO DE CLIENTES", "action": "click", "target": "FACTURAS"},
    {"screen": "BUSQUEDA DE FACTURAS", "action": "open_screen", "target": "BUSQUEDA DE FACTURAS"},
    {"screen": "BUSQUEDA DE FACTURAS", "action": "select", "target": "CLIENTE", "value": "INVERSIONES TAMBOPATA S.A.C."},
    {"screen": "BUSQUEDA DE FACTURAS", "action": "select", "target": "ESTADO", "value": "PENDIENTE"},
    {"screen": "BUSQUEDA DE FACTURAS", "action": "click", "target": "BUSCAR"},
    {"screen": "BUSQUEDA DE FACTURAS", "action": "select", "target": "RESULTADOS", "value": "F001-000110"},
    {"screen": "BUSQUEDA DE FACTURAS", "action": "click", "target": "REGISTRAR PAGO"},
    {"screen": "REGISTRAR PAGO", "action": "open_screen", "target": "REGISTRAR PAGO"},
    {"screen": "REGISTRAR PAGO", "action": "type", "target": "MONTO S/", "value": "300.00"},
    {"screen": "REGISTRAR PAGO", "action": "select", "target": "METODO", "value": "TRANSFERENCIA"},
    {"screen": "REGISTRAR PAGO", "action": "type", "target": "NRO. OPERACION", "value": "OP-784512"},
    {"screen": "REGISTRAR PAGO", "action": "click", "target": "GRABAR"},
    {"screen": "BUSQUEDA DE FACTURAS", "action": "open_screen", "target": "BUSQUEDA DE FACTURAS"},
    {"screen": "BUSQUEDA DE FACTURAS", "action": "see_message", "target": "OPERACION COMPLETADA SATISFACTORIAMENTE."},
    {"screen": "BUSQUEDA DE FACTURAS", "action": "click", "target": "ACEPTAR"}
  ],
  "workflows": [
    {"name": "Login", "steps": [1, 2, 3, 4, 5]},
    {"name": "Register customer", "steps": [6, 7, 8, 9, 10, 11, 12, 13, 14]},
    {"name": "Search invoices", "steps": [15, 16, 17, 18, 19, 20, 21, 22]},
    {"name": "Register partial payment", "steps": [23, 24, 25, 26, 27, 28, 29]}
  ],
  "rules": [
    {"name": "Login opens the customer screen", "patterns": ["INICIO DE SESION|LOGIN", "REGISTRO DE CLIENTES"]},
    {"name": "RUC / DNI is required (ERROR 0x0042)", "patterns": ["0X0042", "RUC"]},
    {"name": "Saving a customer adds a record (6 -> 7)", "patterns": ["CLIENT|CUSTOMER|REGISTR", "\\b6\\b.*\\b7\\b"]},
    {"name": "A successful save shows OPERACION COMPLETADA SATISFACTORIAMENTE", "patterns": ["OPERACION COMPLETADA"]},
    {"name": "REGISTRAR PAGO is enabled only after choosing an invoice", "patterns": ["REGISTRAR PAGO", "ENABL|HABILIT|DISABL"]},
    {"name": "A partial payment changes PENDIENTE to PARCIAL", "patterns": ["PENDIENTE", "PARCIAL"]},
    {"name": "New balance = balance - payment (640 - 300 = 340)", "patterns": ["640", "300", "340"]}
  ]
}
